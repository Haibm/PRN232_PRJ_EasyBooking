@page
@model EasyBooking.Web.Pages.Authen.ProfileModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}
<h2>Thông tin cá nhân</h2>

<div class="row">
    <!-- Sidebar -->
    <div class="col-md-3">
        @await Html.PartialAsync("Shared/_UserSidebar")
    </div>

    <!-- Main Content -->
    <div class="col-md-9">
        <div class="card">
            <div class="card-header bg-dark text-white">
                Thông tin cá nhân
            </div>
            <div class="card-body">
                <form id="profileForm">
                    <div class="mb-3">
                        <label class="form-label">Tên tài khoản:</label>
                        <input id="profileUsername" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Họ tên:</label>
                        <input id="profileFullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email:</label>
                        <input id="profileEmail" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu thông tin</button>
                    <div id="profileSuccess" class="mt-2 alert alert-success" style="display:none">Cập nhật thành công!</div>
                    <div id="profileError" class="mt-2 alert alert-danger" style="display:none"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
function parseJwt (token) {
    if (!token) return null;
    try {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
        return JSON.parse(jsonPayload);
    } catch { return null; }
}
const token = localStorage.getItem('jwtToken');
const payload = parseJwt(token);
const userId = payload && payload.userId;
if (!userId) {
    window.location.href = '/authen/Login';
}
// Lấy thông tin user
fetch(`https://localhost:7087/api/users/${userId}`, {
    method: 'GET',
    headers: {
        'Authorization': 'Bearer ' + token
    }
})
.then(res => res.json())
.then(user => {
    document.getElementById('profileUsername').value = user.username || '';
    document.getElementById('profileFullName').value = user.fullName || '';
    document.getElementById('profileEmail').value = user.email || '';
});
// Cập nhật thông tin
const form = document.getElementById('profileForm');
form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const userData = {
        userId: userId,
        username: document.getElementById('profileUsername').value,
        fullName: document.getElementById('profileFullName').value,
        email: document.getElementById('profileEmail').value
    };
    const res = await fetch(`https://localhost:7087/api/users/${userId}`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify(userData)
    });
    if (res.ok) {
        document.getElementById('profileSuccess').style.display = 'block';
        document.getElementById('profileError').style.display = 'none';
    } else {
        document.getElementById('profileSuccess').style.display = 'none';
        document.getElementById('profileError').style.display = 'block';
        document.getElementById('profileError').innerText = 'Cập nhật thông tin thất bại.';
    }
});
</script>
}
