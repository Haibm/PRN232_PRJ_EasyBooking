@page
@model EasyBooking.Web.Pages.authen.OrderHistoryModel
@{
    ViewData["Title"] = "Lịch sử đặt vé";
}
<div class="container mt-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            @await Html.PartialAsync("Shared/_UserSidebar")
        </div>
        <div class="col-md-9">
            <h2 class="mb-4">Lịch sử đặt vé</h2>
            @if (TempData["RefundSuccess"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <strong>Hoàn vé thành công!</strong> 
                    Ghế đã được mở khóa và có thể đặt lại. Số tiền hoàn vé được tính tự động (80% giá vé gốc).
                </div>
            }
            @if (TempData["RefundError"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Hoàn vé thất bại:</strong> @TempData["RefundError"]
                </div>
            }
            <table class="table table-bordered table-hover bg-white shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Vé đã mua</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.OrderHistories == null || !Model.OrderHistories.Any())
                {
                    <tr><td colspan="5" class="text-center text-secondary">Không có lịch sử đặt vé.</td></tr>
                }
                else
                {
                    foreach (var h in Model.OrderHistories)
                    {
                        <tr>
                            <td>@h.OrderHistoryId</td>
                            <td>@(h.Timestamp?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                            <td>@h.OrderStatus</td>
                            <td>@h.OrderNote</td>
                            <td>
                                <form method="post" asp-page-handler="ShowTickets">
                                    <input type="hidden" name="showTicketsOrderId" value="@h.OrderHistoryId" />
                                    <button type="submit" class="btn btn-sm btn-info">Chi tiết</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
            @if (Model.Tickets != null && Model.Tickets.Any())
            {
                <div class="card mt-4">
                    <div class="card-header"><b>Chi tiết vé đã mua (Đơn: @Model.ShowTicketsOrderId)</b></div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Mã vé</th>
                                    <th>Phim</th>
                                    <th>Rạp</th>
                                    <th>Phòng</th>
                                    <th>Suất chiếu</th>
                                    <th>Ghế</th>
                                    <th>Thời gian đặt</th>
                                    <th>Trạng thái</th>
                                    <th>Hoàn vé</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var t in Model.Tickets)
                            {
                                <tr>
                                    <td>@t.TicketId</td>
                                    <td>@t.MovieTitle</td>
                                    <td>@t.CinemaName</td>
                                    <td>@t.RoomName</td>
                                    <td>@(t.ShowtimeStart?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                    <td>@t.SeatNumber</td>
                                    <td>@(t.BookingTime?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                    <td><span class="badge bg-primary">Đã đặt</span></td>
                                    <td>
                                        <form method="post" asp-page-handler="Refund">
                                            <input type="hidden" name="RefundTicketId" value="@t.TicketId" />
                                            <input type="hidden" name="RefundAmount" value="50000" />
                                            <input type="text" name="RefundReason" placeholder="Lý do hoàn vé..." required style="width:150px;" />
                                            <button type="submit" class="btn btn-warning btn-sm">Hoàn vé</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            @if (Model.RefundedTickets != null && Model.RefundedTickets.Any())
            {
                <div class="card mt-4">
                    <div class="card-header bg-success text-white"><b>Vé đã hoàn (Đơn: @Model.ShowTicketsOrderId)</b></div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <thead class="table-success">
                                <tr>
                                    <th>Mã vé</th>
                                    <th>Phim</th>
                                    <th>Rạp</th>
                                    <th>Phòng</th>
                                    <th>Suất chiếu</th>
                                    <th>Ghế</th>
                                    <th>Thời gian hoàn</th>
                                    <th>Trạng thái</th>
                                    <th>Thông tin hoàn vé</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var r in Model.RefundedTickets)
                            {
                                <tr class="table-light">
                                    <td>@r.TicketId</td>
                                    <td>@r.MovieTitle</td>
                                    <td>@r.CinemaName</td>
                                    <td>@r.RoomName</td>
                                    <td>@(r.ShowtimeStart?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                    <td>@r.SeatNumber</td>
                                    <td>@(r.RefundTime.ToString("dd/MM/yyyy HH:mm"))</td>
                                    <td><span class="badge bg-success">Đã hoàn</span></td>
                                    <td>
                                        <div class="small">
                                            <strong>Số tiền:</strong> @r.RefundAmount.ToString("N0")đ<br/>
                                            <strong>Lý do:</strong> @r.Reason<br/>
                                            <strong>Thời gian:</strong> @r.RefundTime.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>