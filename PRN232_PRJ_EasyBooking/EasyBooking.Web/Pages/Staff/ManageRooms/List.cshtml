@page
@model EasyBooking.Web.Pages.Staff.ManageRooms.ListModel
@{
    Layout = "_StaffLayout";
}

<div class="container-fluid py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-white px-0 mb-3">
            <li class="breadcrumb-item"><a href="/Staff/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Danh sách phòng chiếu</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a class="btn btn-primary me-2" href="/Staff/ManageRooms/Create"><i class="bi bi-plus-lg"></i> Tạo phòng chiếu</a>
            <a class="btn btn-outline-secondary" href="/Staff/ManageRooms/List"><i class="bi bi-arrow-clockwise"></i> Refresh</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên phòng</th>
                    <th>Sức chứa</th>
                    <th>Vị trí</th>
                    <th>Rạp</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rooms == null)
                {
                    <tr><td colspan="5" class="text-center">Loading...</td></tr>
                }
                else if (!Model.Rooms.Any())
                {
                    <tr><td colspan="5" class="text-center">Không có phòng nào.</td></tr>
                }
                else
                {
                    foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td>@room.Name</td>
                            <td>@room.Capacity</td>
                            <td>@room.Location</td>
                            <td>@room.CinemaName</td>
                            <td>
                                <a class="btn btn-info btn-sm open-seats-modal" data-room-id="@room.RoomId" data-room-name="@room.Name">Seat</a>
                                <a class="btn btn-warning btn-sm" asp-page="Edit" asp-route-roomId="@room.RoomId">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@room.RoomId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this room?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="seatsModal" tabindex="-1" aria-labelledby="seatsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="seatsModalLabel">Cập nhật ghế phòng chiếu <span id="modalRoomName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <div class="bg-dark text-white py-1">MÀN HÌNH</div>
                </div>
                <div class="mb-2 text-center">
                    <button id="addRowBtn" class="btn btn-outline-success btn-sm">+ Hàng</button>
                    <button id="addColBtn" class="btn btn-outline-success btn-sm">+ Cột</button>
                </div>
                <div id="seatGrid" class="d-flex flex-column align-items-center mb-3"></div>
                <div class="d-flex justify-content-center gap-3">
                    <span class="badge" style="background:#8e44ad">Ghế thường</span>
                    <span class="badge" style="background:#c0392b">Ghế VIP</span>
                    <span class="badge" style="background:#333">Không khả dụng</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let seatRows = [];
        let seatCols = 0;
        let seats = [];
        let currentRoomId = null;

        function getSeatColorClass(type, isAvailable = true) {
            if (!isAvailable) return 'bg-dark text-white';
            return type === 'VIP' ? 'bg-danger text-white' : 'bg-purple text-white';
        }

        async function loadSeatsFromApi(roomId) {
            const res = await fetch(`https://localhost:7087/api/staff/rooms/${roomId}/seats`);
            if (!res.ok) return [];
            return await res.json();
        }

        async function reloadSeats(roomId) {
            seats = await loadSeatsFromApi(roomId);
            seatRows = [...new Set(seats.map(s => s.rowLetter))];
            seatRows.sort();
            seatCols = Math.max(...seats.map(s => s.seatNumber));
            renderSeatGrid();
        }

        function renderSeatGrid() {
            let html = '';
            // Dòng nút X xóa cột
            html += '<div class="d-flex justify-content-center mb-1">';
            html += '<span style="width:40px;display:inline-block;"></span>';
            for (let c = 1; c <= seatCols; c++) {
                html += `<span style="width:32px;display:inline-block;text-align:center;">
                    <button class='btn btn-danger btn-xs del-col-btn' data-col='${c}' style='padding:0 4px;font-size:10px;margin-bottom:2px;'>X</button>
                </span>`;
            }
            html += '</div>';
            // Dòng số thứ tự cột (căn giữa với ghế)
            html += '<div class="d-flex justify-content-center mb-1">';
            html += '<span style="width:40px;display:inline-block;"></span>';
            for (let c = 1; c <= seatCols; c++) {
                html += `<span style="width:32px;height:32px;display:inline-block;text-align:center;line-height:32px;">${c}</span>`;
            }
            html += '</div>';

            // Lưới ghế với nút xóa hàng
            seatRows.forEach(row => {
                html += '<div class="d-flex justify-content-center mb-1">';
                html += `<span style="width:40px;display:inline-block;text-align:center;">${row}</span>`;
                for (let i = 1; i <= seatCols; i++) {
                    const seat = seats.find(s => s.rowLetter === row && s.seatNumber === i);
                    if (seat) {
                        const seatClass = getSeatColorClass(seat.seatType, !seat.deleted);
                        const disabled = seat.deleted ? 'disabled' : '';
                        html += `<button class="btn seat-btn ${seatClass}" data-seat-id="${seat.seatId}" style="width:32px;height:32px;font-size:12px;margin:2px;" ${disabled}>${row}${i}</button>`;
                    } else {
                        html += `<span style="width:32px;height:32px;margin:2px;"></span>`;
                    }
                }
                // Nút xóa hàng bên phải
                html += `<span style="width:40px;display:inline-block;text-align:center;position:relative;">
                    <button class='btn btn-danger btn-xs del-row-btn' data-row='${row}' style='position:absolute;top:0;right:0;padding:0 4px;font-size:10px;'>X</button>
                </span>`;
                html += '</div>';
            });

            document.getElementById('seatGrid').innerHTML = html;
        }

        document.addEventListener('click', async function (e) {
            const t = e.target;

            if (t.classList.contains('open-seats-modal')) {
                currentRoomId = t.dataset.roomId;
                document.getElementById('modalRoomName').innerText = t.dataset.roomName;
                await reloadSeats(currentRoomId);
                new bootstrap.Modal(document.getElementById('seatsModal')).show();
            }

            if (t.classList.contains('seat-btn')) {
                const id = t.dataset.seatId;
                const seat = seats.find(s => s.seatId == id);
                if (!seat) return;
                seat.seatType = seat.seatType === 'VIP' ? 'Regular' : 'VIP';
                await fetch(`https://localhost:7087/api/staff/seats/${seat.seatId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(seat)
                });
                await reloadSeats(currentRoomId);
            }

            // Xử lý xóa hàng với xác nhận
            if (t.classList.contains('del-row-btn')) {
                const row = t.dataset.row;
                if (confirm(`Bạn có chắc muốn xóa toàn bộ hàng ${row}?`)) {
                    try {
                        const seatsToDelete = seats.filter(s => s.rowLetter === row);
                        console.log(`Xóa ${seatsToDelete.length} ghế của hàng ${row}:`, seatsToDelete);
                        for (let i = 0; i < seatsToDelete.length; i++) {
                            const seat = seatsToDelete[i];
                            try {
                                const response = await fetch(`https://localhost:7087/api/staff/seats/${seat.seatId}`, { 
                                    method: 'DELETE' 
                                });
                                if (!response.ok) {
                                    console.error(`Lỗi xóa ghế ${seat.seatId}:`, response.status, response.statusText);
                                }
                                // await new Promise(res => setTimeout(res, 30)); // Nếu cần delay
                            } catch (err) {
                                console.error(`Lỗi khi xóa ghế ${seat.seatId}:`, err);
                            }
                        }
                        console.log(`Đã xóa xong hàng ${row}`);
                        await reloadSeats(currentRoomId);
                    } catch (error) {
                        console.error('Lỗi khi xóa hàng:', error);
                        alert('Có lỗi xảy ra khi xóa hàng!');
                    }
                }
            }

            // Xử lý xóa cột với xác nhận
            if (t.classList.contains('del-col-btn')) {
                const col = parseInt(t.dataset.col);
                if (confirm(`Bạn có chắc muốn xóa toàn bộ cột ${col}?`)) {
                    try {
                        const seatsToDelete = seats.filter(s => s.seatNumber === col);
                        console.log(`Xóa ${seatsToDelete.length} ghế của cột ${col}:`, seatsToDelete);
                        for (let i = 0; i < seatsToDelete.length; i++) {
                            const seat = seatsToDelete[i];
                            try {
                                const response = await fetch(`https://localhost:7087/api/staff/seats/${seat.seatId}`, { 
                                    method: 'DELETE' 
                                });
                                if (!response.ok) {
                                    console.error(`Lỗi xóa ghế ${seat.seatId}:`, response.status, response.statusText);
                                }
                                // await new Promise(res => setTimeout(res, 30)); // Nếu cần delay
                            } catch (err) {
                                console.error(`Lỗi khi xóa ghế ${seat.seatId}:`, err);
                            }
                        }
                        console.log(`Đã xóa xong cột ${col}`);
                        await reloadSeats(currentRoomId);
                    } catch (error) {
                        console.error('Lỗi khi xóa cột:', error);
                        alert('Có lỗi xảy ra khi xóa cột!');
                    }
                }
            }
        });

        // Xử lý thêm hàng
        document.getElementById('addRowBtn').onclick = async function () {
            // Nếu chưa có cột nào, tạo cột đầu tiên
            if (seatCols === 0) seatCols = 1;
            const nextRow = String.fromCharCode(65 + seatRows.length);
            for (let i = 1; i <= seatCols; i++) {
                const payload = { roomId: currentRoomId, rowLetter: nextRow, seatNumber: i, seatType: 'Regular' };
                console.log('POST add seat:', payload);
                await fetch(`https://localhost:7087/api/staff/seats`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }
            await reloadSeats(currentRoomId);
        };

        // Xử lý thêm cột
        document.getElementById('addColBtn').onclick = async function () {
            // Nếu chưa có hàng nào, tạo hàng đầu tiên trên backend
            if (seatRows.length === 0) {
                seatRows = ['A'];
                seatCols = 0;
            }
            seatCols++;
            for (const row of seatRows) {
                const payload = { roomId: currentRoomId, rowLetter: row, seatNumber: seatCols, seatType: 'Regular' };
                console.log('POST add seat:', payload);
                await fetch(`https://localhost:7087/api/staff/seats`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }
            await reloadSeats(currentRoomId);
        };
    </script>

    <style>
        .bg-purple {
            background-color: #8e44ad !important;
            color: white;
        }

        .bg-danger {
            background-color: #c0392b !important;
            color: white;
        }
        #seatGrid .seat-btn {
            width: 32px;
            height: 32px;
            padding: 0;
            font-size: 13px;
            margin: 0; /* Đảm bảo không có margin */
            position: relative;
        }
        #seatGrid .d-flex {
            gap: 2px; /* Nếu muốn có khoảng cách giữa các ghế và số cột */
        }
    </style>

}
