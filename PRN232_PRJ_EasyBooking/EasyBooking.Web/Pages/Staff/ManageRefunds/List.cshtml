@page
@model EasyBooking.Web.Pages.Staff.ManageRefunds.ListModel
@{
    ViewData["Title"] = "Quản lý hoàn vé";
    Layout = "_StaffLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-undo"></i> Quản lý hoàn vé</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Bộ lọc</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" class="form-control" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" class="form-control" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Phim</label>
                    <select class="form-select" name="movieId">
                        <option value="">Tất cả phim</option>
                        @foreach (var movie in Model.Movies)
                        {
                            if (Model.SelectedMovieId == movie.MovieId)
                            {
                                <option value="@movie.MovieId" selected>@movie.Title</option>
                            }
                            else
                            {
                                <option value="@movie.MovieId">@movie.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Rạp</label>
                    <select class="form-select" name="cinemaId">
                        <option value="">Tất cả rạp</option>
                        @foreach (var cinema in Model.Cinemas)
                        {
                            if (Model.SelectedCinemaId == cinema.CinemaId)
                            {
                                <option value="@cinema.CinemaId" selected>@cinema.Name</option>
                            }
                            else
                            {
                                <option value="@cinema.CinemaId">@cinema.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Lọc
                    </button>
                    <a href="@Url.Page("/Staff/ManageRefunds/List")" class="btn btn-secondary">
                        <i class="fas fa-refresh"></i> Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.TotalRefunds</h4>
                            <small>Tổng vé hoàn</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-ticket-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.TotalRefundAmount.ToString("N0")đ</h4>
                            <small>Tổng tiền hoàn</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-money-bill-wave fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.TodayRefunds</h4>
                            <small>Hoàn hôm nay</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-calendar-day fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.AverageRefundAmount.ToString("N0")đ</h4>
                            <small>Trung bình/vé</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-chart-line fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Refunds Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-list"></i> Danh sách vé đã hoàn</h5>
        </div>
        <div class="card-body">
            @if (Model.Refunds != null && Model.Refunds.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Mã vé</th>
                                <th>Khách hàng</th>
                                <th>Phim</th>
                                <th>Rạp</th>
                                <th>Phòng</th>
                                <th>Suất chiếu</th>
                                <th>Ghế</th>
                                <th>Số tiền hoàn</th>
                                <th>Lý do</th>
                                <th>Thời gian hoàn</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var refund in Model.Refunds)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@refund.TicketId</span></td>
                                    <td>@refund.UserName</td>
                                    <td><strong>@refund.MovieTitle</strong></td>
                                    <td>@refund.CinemaName</td>
                                    <td>@refund.RoomName</td>
                                    <td>@(refund.ShowtimeStart?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                    <td><span class="badge bg-info">@refund.SeatNumber</span></td>
                                    <td><span class="text-success fw-bold">@refund.RefundAmount.ToString("N0")đ</span></td>
                                    <td>@refund.Reason</td>
                                    <td>@refund.RefundTime.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm btn-info" onclick="viewRefundDetails(@refund.RefundHistoryId)">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Không có vé hoàn nào</h5>
                    <p class="text-muted">Chưa có vé nào được hoàn trong khoảng thời gian này.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Chi tiết hoàn vé -->
<div class="modal fade" id="refundDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết hoàn vé</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="refundDetailContent">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewRefundDetails(refundHistoryId) {
            // Load refund details via AJAX
            fetch(`/api/staff/refunds/${refundHistoryId}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('refundDetailContent').innerHTML = `
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Thông tin vé</h6>
                                <p><strong>Mã vé:</strong> ${data.ticketId}</p>
                                <p><strong>Phim:</strong> ${data.movieTitle}</p>
                                <p><strong>Rạp:</strong> ${data.cinemaName}</p>
                                <p><strong>Phòng:</strong> ${data.roomName}</p>
                                <p><strong>Suất chiếu:</strong> ${new Date(data.showtimeStart).toLocaleString()}</p>
                                <p><strong>Ghế:</strong> ${data.seatNumber}</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Thông tin hoàn vé</h6>
                                <p><strong>Số tiền hoàn:</strong> <span class="text-success fw-bold">${data.refundAmount.toLocaleString()}đ</span></p>
                                <p><strong>Lý do:</strong> ${data.reason}</p>
                                <p><strong>Thời gian hoàn:</strong> ${new Date(data.refundTime).toLocaleString()}</p>
                                <p><strong>Khách hàng:</strong> ${data.userName}</p>
                            </div>
                        </div>
                    `;
                    new bootstrap.Modal(document.getElementById('refundDetailModal')).show();
                });
        }
    </script>
} 