<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyBooking.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EasyBooking.Web.styles.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">EasyBooking.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <ul class="navbar-nav me-auto mx-auto" style="float:none;display:flex;justify-content:center;width:100%;">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/User/OrderShowtimes">OrderShowtimes</a>
                        </li>
                    </ul>
                    <!-- User navbar will be rendered here by JS -->
                    <ul class="navbar-nav" id="navbarUser"></ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function parseJwt(token) {
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function (c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload);
            } catch (e) {
                console.error("Error decoding token:", e);
                return null;
            }
        }
        function isTokenExpired(token) {
            const payload = parseJwt(token);
            if (!payload || !payload.exp) return true;
            return (Date.now() / 1000) > payload.exp;
        }
        function renderNavbarUser() {
            const navbar = document.getElementById('navbarUser');
            if (!navbar) return;
            const token = localStorage.getItem('jwtToken');
            if (!token || isTokenExpired(token)) {
                localStorage.removeItem('jwtToken');
                navbar.innerHTML = `
                    <li class="nav-item"><a class="nav-link text-dark" href="/authen/Login">Login</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="/authen/Signup">Signup</a></li>
                `;
                return;
            }
            const payload = parseJwt(token);
            const nameClaim = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name";
            const username = payload[nameClaim] || 'User';
            navbar.innerHTML = `
                <li class="nav-item dropdown">
                    <a class="btn btn-secondary dropdown-toggle user-greeting" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        Hello, ${username}!
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="/authen/Profile">View Profile</a></li>
                        <li><a class="dropdown-item" href="/authen/Setting">Setting</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link text-dark" onclick="logout()">Logout</a>
                </li>
            `;
        }
        function logout() {
            localStorage.removeItem('jwtToken');
            window.location.href = '/authen/Login';
        }
        document.addEventListener('DOMContentLoaded', renderNavbarUser);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>