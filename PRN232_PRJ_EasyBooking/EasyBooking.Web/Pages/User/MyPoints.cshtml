@page
@model EasyBooking.Web.Pages.User.MyPointsModel
@{
    ViewData["Title"] = "Điểm thưởng của tôi";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">
                <i class="fas fa-star text-warning"></i>
                Điểm thưởng của tôi
            </h2>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Thông tin điểm hiện tại -->
        <div class="col-md-4 mb-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-coins"></i>
                        Điểm hiện tại
                    </h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-primary mb-0">@Model.CurrentPoints</h2>
                    <small class="text-muted">điểm</small>
                </div>
            </div>
        </div>

        <!-- Tổng điểm đã tích -->
        <div class="col-md-4 mb-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle"></i>
                        Tổng điểm đã tích
                    </h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-success mb-0">@Model.TotalEarnedPoints</h2>
                    <small class="text-muted">điểm</small>
                </div>
            </div>
        </div>

        <!-- Tổng điểm đã sử dụng -->
        <div class="col-md-4 mb-4">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-minus-circle"></i>
                        Tổng điểm đã sử dụng
                    </h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-info mb-0">@Model.TotalUsedPoints</h2>
                    <small class="text-muted">điểm</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Lịch sử giao dịch điểm -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-history"></i>
                        Lịch sử giao dịch điểm
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.PointTransactions != null && Model.PointTransactions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Ngày</th>
                                        <th>Loại giao dịch</th>
                                        <th>Điểm</th>
                                        <th>Mô tả</th>
                                        <th>Mã đơn hàng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in Model.PointTransactions)
                                    {
                                        <tr>
                                            <td>@transaction.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (transaction.TransactionType == "EARN")
                                                {
                                                    <span class="badge bg-success">Tích điểm</span>
                                                }
                                                else if (transaction.TransactionType == "USE")
                                                {
                                                    <span class="badge bg-warning">Sử dụng</span>
                                                }
                                                else if (transaction.TransactionType == "REDEEM")
                                                {
                                                    <span class="badge bg-info">Đổi mã giảm giá</span>
                                                }
                                            </td>
                                            <td>
                                                @if (transaction.TransactionType == "EARN")
                                                {
                                                    <span class="text-success">+@transaction.Points</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">-@transaction.Points</span>
                                                }
                                            </td>
                                            <td>@transaction.Description</td>
                                            <td>
                                                @if (transaction.OrderId.HasValue)
                                                {
                                                    <span class="badge bg-secondary">#@transaction.OrderId</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Chưa có giao dịch điểm nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cách tích điểm -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i>
                        Cách tích điểm
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-ticket-alt text-primary"></i> Mua vé xem phim</h6>
                            <p class="text-muted">
                                @if (Model.PointConfig != null)
                                {
                                    <text>Tích @Model.PointConfig.AmountPerPoint điểm cho mỗi @Model.PointConfig.MinAmountToEarn.ToString("N0") VNĐ</text>
                                }
                                else
                                {
                                    <text>Tích điểm theo cấu hình hiện tại</text>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-gift text-success"></i> Đổi mã giảm giá</h6>
                            <p class="text-muted">Sử dụng điểm để đổi mã giảm giá</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 