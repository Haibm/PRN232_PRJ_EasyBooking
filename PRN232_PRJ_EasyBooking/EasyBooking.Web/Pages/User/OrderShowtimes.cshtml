@page
@model EasyBooking.Web.Pages.User.OrderShowtimesModel
@{
    ViewData["Title"] = "Đặt lịch chiếu phim";
}

<div class="container mt-4">
    <h2 class="mb-4">Lịch chiếu phim</h2>
    <div class="row">
        <!-- Sidebar chọn rạp -->
        <div class="col-md-3">
            <div class="list-group mb-3">
                @foreach (var c in Model.Cinemas)
                {
                    <a href="?cinemaId=@c.CinemaId&day=@Model.SelectedDay.ToString("yyyy-MM-dd")" class="list-group-item list-group-item-action @(c.CinemaId == Model.SelectedCinemaId ? "active" : "")">
                        @c.Name
                    </a>
                }
            </div>
        </div>
        <!-- Main content -->
        <div class="col-md-9">
            <!-- Thanh chọn ngày -->
            <div class="d-flex mb-3 overflow-auto" style="gap:8px;">
                @foreach (var d in Model.Days)
                {
                    <a href="?cinemaId=@Model.SelectedCinemaId&day=@d.ToString("yyyy-MM-dd")" class="btn btn-outline-primary @(d == Model.SelectedDay ? "active" : "")" style="min-width:80px;">
                        @d.ToString("dd")<br />@d.ToString("ddd", new System.Globalization.CultureInfo("vi-VN"))
                    </a>
                }
            </div>
            <!-- Danh sách phim và suất chiếu -->
            <div>
                @if (Model.Movies != null && Model.Movies.Count > 0)
                {
                    @foreach (var m in Model.Movies)
                    {
                        <div class="card mb-3">
                            <div class="row g-0">
                                <div class="col-md-2 d-flex align-items-center">
                                    <img src="@m.PosterUrl" class="img-fluid rounded-start" alt="@m.Title" style="max-height:120px;">
                                </div>
                                <div class="col-md-10">
                                    <div class="card-body">
                                        <h5 class="card-title">@m.Title</h5>
                                        <p class="card-text text-muted">@m.Description</p>
                                        <div class="mb-2">
                                            <span class="badge bg-info text-dark me-1">@m.Duration phút</span>
                                            @foreach (var g in m.Genres ?? new List<string>())
                                            {
                                                <span class="badge bg-secondary me-1">@g</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap" style="gap:8px;">
                                            @foreach (var s in m.Showtimes ?? new List<EasyBooking.Business.DTOs.OrderShowtimeDTO.Showtime>())
                                            {
                                                var roomName = Model.Rooms?.FirstOrDefault(r => r.RoomId == s.RoomId)?.Name ?? "";
                                                var cinemaName = Model.Cinemas?.FirstOrDefault(c => c.CinemaId == Model.SelectedCinemaId)?.Name ?? "";
                                                <button class="btn btn-outline-success btn-sm showtime-btn"
                                                    data-movie="@m.Title"
                                                    data-showtime="@s.StartTime.ToString("yyyy-MM-dd HH:mm")"
                                                    data-room-id="@s.RoomId"
                                                    data-showtime-id="@s.ShowtimeId"
                                                    data-vip-percent="@s.VipPercent"
                                                    data-price="@s.Price"
                                                    data-cinema-name="@cinemaName"
                                                    data-room-name="@roomName">
                                                    @s.StartTime.ToString("HH:mm dd-MM-yyyy")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">Không có lịch chiếu cho rạp và ngày này.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal chọn ghế -->
<div class="modal fade" id="seatModal" tabindex="-1" aria-labelledby="seatModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header" style="background:#e91e63;color:#fff;">
        <h5 class="modal-title" id="seatModalLabel">Mua vé xem phim</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="text-center mb-2"><b>MÀN HÌNH</b></div>
        <div id="seatGrid" class="d-flex flex-column align-items-center mb-3"></div>
        <div class="mb-2">
          <span class="badge bg-secondary">Ghế thường</span>
          <span class="badge bg-warning text-dark">Ghế VIP</span>
          <span class="badge bg-danger">Đã đặt</span>
          <span class="badge bg-success">Ghế bạn chọn</span>
        </div>
        <div class="mt-3">
          <b>Phim:</b> <span id="modalMovie"></span><br />
          <b>Suất chiếu:</b> <span id="modalShowtime"></span><br />
          <b>Chỗ ngồi:</b> <span id="selectedSeats"></span>
        </div>
        <div class="mt-2">
          <b>Tạm tính:</b> <span id="totalPrice">0</span>đ
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="buyTicketBtn">Mua vé</button>
      </div>
    </div>
  </div>
</div>

<style>
    .list-group-item.active {
        background-color: #e91e63;
        border-color: #e91e63;
        color: #fff;
    }
    .btn-outline-primary.active, .btn-outline-primary:active {
        background-color: #e91e63;
        border-color: #e91e63;
        color: #fff;
    }
</style>

@section Scripts {
    <script>
        var userId = @(Model.UserId ?? 0);
        let seatRows = [];
        let seatCols = 0;
        let seats = [];
        let bookedSeats = [];
        let selectedSeats = [];
        let currentMovie = "";
        let currentShowtime = "";
        let currentRoomId = null;
        let currentShowtimeId = null;
        let vipPercent;
        let normalPrice;
        const vipPrice = 120000;
        let currentCinemaName = "";
        let currentRoomName = "";

        async function loadSeatsFromApi(roomId) {
            const res = await fetch(`https://localhost:7087/api/staff/rooms/${roomId}/seats`);
            if (!res.ok) return [];
            return await res.json();
        }
        async function loadBookedSeats(showtimeId) {
            const res = await fetch(`https://localhost:7087/api/staff/tickets`);
            if (!res.ok) return [];
            const allTickets = await res.json();
            // Lấy seatKey (rowLetter + seatNumber) theo showtimeId
            return allTickets
                .filter(t => t.showtimeId == showtimeId)
                .map(t => (t.rowLetter ? t.rowLetter + t.seatNumber : t.seatNumber));
        }
        function getSeatKey(row, num) {
            return row + num;
        }
        function renderSeatGrid() {
            const grid = document.getElementById('seatGrid');
            grid.innerHTML = '';
            seatRows.forEach(row => {
                const rowDiv = document.createElement('div');
                rowDiv.className = 'd-flex justify-content-center mb-1';
                for(let i=1;i<=seatCols;i++){
                    const seat = seats.find(s => s.rowLetter === row && s.seatNumber === i);
                    if (!seat) {
                        const span = document.createElement('span');
                        span.style.width = '32px';
                        span.style.height = '32px';
                        rowDiv.appendChild(span);
                        continue;
                    }
                    const seatKey = getSeatKey(row, i);
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm seat-btn';
                    btn.innerText = seatKey;
                    btn.dataset.seat = seatKey;
                    btn.dataset.seatId = seat.seatId;
                    if(bookedSeats.includes(seatKey)){
                        btn.classList.add('btn-danger');
                        btn.disabled = true;
                    } else if(seat.seatType === 'VIP'){
                        btn.classList.add('btn-warning');
                    } else {
                        btn.classList.add('btn-secondary');
                    }
                    if(selectedSeats.includes(seatKey)){
                        btn.classList.remove('btn-secondary','btn-warning');
                        btn.classList.add('btn-success');
                    }
                    btn.onclick = function(){
                        if(selectedSeats.includes(seatKey)){
                            selectedSeats = selectedSeats.filter(s=>s!==seatKey);
                        } else {
                            selectedSeats.push(seatKey);
                        }
                        renderSeatGrid();
                        updateSeatInfo();
                    };
                    rowDiv.appendChild(btn);
                }
                grid.appendChild(rowDiv);
            });
        }
        function updateSeatInfo(){
            document.getElementById('selectedSeats').innerText = selectedSeats.join(', ');
            let total = 0;
            selectedSeats.forEach(seatKey=>{
                const seat = seats.find(s => getSeatKey(s.rowLetter, s.seatNumber) === seatKey);
                if (seat && seat.seatType === 'VIP') {
                    total += Math.round(normalPrice * (1 + vipPercent/100));
                } else {
                    total += normalPrice;
                }
            });
            document.getElementById('totalPrice').innerText = total.toLocaleString();
        }
        // Sự kiện mở modal khi bấm suất chiếu
        document.addEventListener('DOMContentLoaded', function(){
            document.querySelectorAll('.showtime-btn').forEach(btn=>{
                btn.addEventListener('click', async function(){
                    currentMovie = btn.dataset.movie;
                    currentShowtime = btn.dataset.showtime;
                    currentRoomId = btn.dataset.roomId;
                    currentShowtimeId = btn.dataset.showtimeId;
                    vipPercent = parseInt(btn.dataset.vipPercent);
                    normalPrice = parseInt(btn.dataset.price);
                    currentCinemaName = btn.dataset.cinemaName || "";
                    currentRoomName = btn.dataset.roomName || "";
                    document.getElementById('modalMovie').innerText = currentMovie;
                    document.getElementById('modalShowtime').innerText = currentShowtime;
                    selectedSeats = [];
                    seats = await loadSeatsFromApi(currentRoomId);
                    seatRows = [...new Set(seats.map(s => s.rowLetter))];
                    seatRows.sort();
                    seatCols = Math.max(...seats.map(s => s.seatNumber));
                    bookedSeats = await loadBookedSeats(currentShowtimeId);
                    renderSeatGrid();
                    updateSeatInfo();
                    var modal = new bootstrap.Modal(document.getElementById('seatModal'));
                    modal.show();
                });
            });
        });
        document.getElementById('buyTicketBtn').onclick = async function(){
    if (!selectedSeats || selectedSeats.length === 0) {
        alert("Bạn phải chọn ít nhất 1 ghế!");
        return;
    }
            const orderData = {
                MovieTitle: currentMovie,
                ShowtimeStr: document.getElementById('modalShowtime').innerText,
                CinemaName: currentCinemaName,
                RoomName: currentRoomName,
                Seats: selectedSeats,
                TotalPrice: parseInt(document.getElementById('totalPrice').innerText.replace(/\D/g, '')),
                ShowtimeId: parseInt(currentShowtimeId)
            };
            console.log('orderData:', orderData);
    const token = localStorage.getItem('jwtToken');
    // Gọi API init order
    const res = await fetch('https://localhost:7087/api/user/orders/init', {
                method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
        },
                body: JSON.stringify(orderData)
    });
    if (!res.ok) {
        alert('Có lỗi khi gửi order: ' + (await res.text()));
        return;
    }
    const data = await res.json();
    sessionStorage.setItem('orderData', JSON.stringify(data));
                    window.location.href = '/user/order';
        };
    </script>
    <style>
        #seatGrid .seat-btn { width: 32px; height: 32px; padding: 0; font-size: 13px; margin: 2px; }
        #seatGrid .btn-success { border: 2px solid #fff; }
    </style>
}
