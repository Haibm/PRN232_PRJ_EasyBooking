@page
@model EasyBooking.Web.Pages.User.DiscountCodesModel
@{
    ViewData["Title"] = "Mã giảm giá";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">
                <i class="fas fa-tags text-primary"></i>
                Mã giảm giá
            </h2>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Mã giảm giá có sẵn -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-gift"></i>
                        Mã giảm giá có sẵn
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.AvailableCodes != null && Model.AvailableCodes.Any())
                    {
                        <div class="row">
                            @foreach (var code in Model.AvailableCodes)
                            {
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100 border-primary">
                                        <div class="card-header bg-primary text-white">
                                            <h6 class="mb-0">
                                                <i class="fas fa-tag"></i>
                                                @code.Name
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text">@code.Description</p>
                                            <div class="row text-center">
                                                @if (code.DiscountPercentage > 0)
                                                {
                                                    <div class="col-6">
                                                        <small class="text-muted">Giảm giá</small>
                                                        <div class="fw-bold text-success">@code.DiscountPercentage%</div>
                                                    </div>
                                                }
                                                else if (code.DiscountAmount > 0)
                                                {
                                                    <div class="col-6">
                                                        <small class="text-muted">Giảm giá</small>
                                                        <div class="fw-bold text-success">@code.DiscountAmount.ToString("N0") VNĐ</div>
                                                    </div>
                                                }
                                                <div class="col-6">
                                                    <small class="text-muted">Điểm yêu cầu</small>
                                                    <div class="fw-bold text-warning">@code.RequiredPoints</div>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar"></i>
                                                    @code.StartDate.ToString("dd/MM/yyyy") - @code.EndDate.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                            @if (code.MaxUsage > 0)
                                            {
                                                <div class="mt-2">
                                                    <small class="text-muted">
                                                        <i class="fas fa-users"></i>
                                                        Đã sử dụng: @code.CurrentUsage/@code.MaxUsage
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-footer">
                                            <button class="btn btn-primary btn-sm w-100" 
                                                    onclick="redeemCode(@code.DiscountCodeId, '@code.Name', @code.RequiredPoints)">
                                                <i class="fas fa-exchange-alt"></i>
                                                Đổi mã giảm giá
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-gift fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Hiện tại không có mã giảm giá nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Mã giảm giá đã đổi -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-ticket-alt"></i>
                        Mã giảm giá của tôi
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.MyCodes != null && Model.MyCodes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Mã giảm giá</th>
                                        <th>Tên</th>
                                        <th>Giảm giá</th>
                                        <th>Điểm đã dùng</th>
                                        <th>Ngày đổi</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var userCode in Model.MyCodes)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">@userCode.DiscountCodeCode</span>
                                            </td>
                                            <td>@userCode.DiscountCodeName</td>
                                            <td>
                                                @if (userCode.DiscountPercentage > 0)
                                                {
                                                    <span class="text-success">@userCode.DiscountPercentage%</span>
                                                }
                                                else if (userCode.DiscountAmount > 0)
                                                {
                                                    <span class="text-success">@userCode.DiscountAmount.ToString("N0") VNĐ</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-warning">@userCode.PointsUsed điểm</span>
                                            </td>
                                            <td>@userCode.RedeemDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (userCode.IsUsed)
                                                {
                                                    <span class="badge bg-secondary">Đã sử dụng</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Chưa sử dụng</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!userCode.IsUsed)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            onclick="copyCode('@userCode.DiscountCodeCode')">
                                                        <i class="fas fa-copy"></i>
                                                        Copy
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Bạn chưa có mã giảm giá nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận đổi mã giảm giá -->
<div class="modal fade" id="redeemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận đổi mã giảm giá</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn đổi mã giảm giá <strong id="codeName"></strong>?</p>
                <p>Điểm cần dùng: <span id="requiredPoints" class="text-warning"></span></p>
                <p>Điểm hiện tại: <span id="currentPoints" class="text-success"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="confirmRedeem">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedCodeId = null;

    function redeemCode(codeId, codeName, requiredPoints) {
        selectedCodeId = codeId;
        document.getElementById('codeName').textContent = codeName;
        document.getElementById('requiredPoints').textContent = requiredPoints + ' điểm';
        document.getElementById('currentPoints').textContent = '@Model.CurrentPoints' + ' điểm';
        
        if (@Model.CurrentPoints < requiredPoints) {
            alert('Không đủ điểm để đổi mã giảm giá này!');
            return;
        }
        
        var modal = new bootstrap.Modal(document.getElementById('redeemModal'));
        modal.show();
    }

    document.getElementById('confirmRedeem').addEventListener('click', async function() {
        if (!selectedCodeId) return;
        
        try {
            const token = getCookie('jwtToken');
            const response = await fetch(`https://localhost:7087/api/user/discount-codes/redeem/${selectedCodeId}`, {
                method: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                }
            });
            
            if (response.ok) {
                location.reload();
            } else {
                const error = await response.json();
                alert('Lỗi: ' + (error.error || 'Không thể đổi mã giảm giá'));
            }
        } catch (error) {
            alert('Có lỗi xảy ra: ' + error.message);
        }
    });

    function copyCode(code) {
        navigator.clipboard.writeText(code).then(function() {
            alert('Đã copy mã giảm giá: ' + code);
        });
    }

    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }
</script> 